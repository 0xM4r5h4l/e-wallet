<Core:StyleSheet id="58d6989a-66f8-11ec-b4c8-0456e5e540ed">
<styleSheet>
<val>c4container[children] {
  dash-style: 11 9;
}

c4person {
  background-color: #8AADB8;
}

c4container[children=""],
c4database {
  background-color: lightblue;
}

c4container[name="E-mail System"],
c4container[name="Mainframe Banking System"] {
  background-color: lightgray;
  color: #444;
}</val>
</styleSheet>
</Core:StyleSheet>
